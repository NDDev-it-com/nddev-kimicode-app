{
  "contract_version": 3,
  "product_name": "nddev-kimicode-app",
  "github_repository": "NDDev-it-com/nddev-kimicode-app",
  "license": "AGPL-3.0-or-later",
  "manifest_ref": "build/manifest.json",
  "version_ref": "build/version.json",
  "managed_state": {
    "stamp_file": "NDDEV-KIMICODE-SETUP.json",
    "stamp_schema": 2,
    "default_target": null,
    "environment_variable": "NDDEV_KIMICODE_TARGET",
    "managed_directory_mode": "0700",
    "managed_file_mode": "0600",
    "preserve_other_state": true,
    "co_owned_config_strategy": "Marked block merge for config.toml, tui.toml, and AGENTS.md; exact managed files for nddev-builder skills, agents, hooks, and mcp.json",
    "legacy_schema_policy": "schema-1 setup state is readable for status, migrate, restore, and remove; launch refuses it"
  },
  "setup_system": {
    "content_catalog_root": "setups",
    "content_setup_ids": ["nddev-builder"],
    "permission_profile_root": "profiles",
    "permission_profile_ids": ["safe", "full-auto"],
    "default_content_setup": "nddev-builder",
    "default_permission_profile": "full-auto",
    "safe_native_permission_mode": "manual",
    "full_auto_native_permission_mode": "auto",
    "yolo_profile_shipped": false,
    "list_command": "python3 cli-tools/nddev_kimicode.py list --json",
    "status_command": "python3 cli-tools/nddev_kimicode.py status --target /absolute/target --json",
    "plan_command": "python3 cli-tools/nddev_kimicode.py plan --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "install_command": "python3 cli-tools/nddev_kimicode.py install --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "switch_profile_command": "python3 cli-tools/nddev_kimicode.py switch-profile --profile safe --target /absolute/target --json",
    "migrate_command": "python3 cli-tools/nddev_kimicode.py migrate --setup nddev-builder --profile full-auto --target /absolute/target --json",
    "restore_command": "python3 cli-tools/nddev_kimicode.py restore --backup 0 --target /absolute/target --json",
    "remove_command": "python3 cli-tools/nddev_kimicode.py remove --target /absolute/target --json",
    "launch_command": "python3 cli-tools/nddev_kimicode.py launch --target /absolute/target --"
  },
  "safety": {
    "absolute_target_required": true,
    "relative_target_rejected": true,
    "target_symlinks_rejected": true,
    "managed_symlinks_rejected": true,
    "managed_hardlinks_rejected": true,
    "bounded_managed_reads": true,
    "canonical_target_binding": true,
    "rollback_on_failure": true,
    "max_backups": 10,
    "launch_requires_clean_managed_target": true,
    "launch_filters_live_credentials": true,
    "launch_blocks_managed_mode_overrides": true,
    "launch_holds_lifecycle_lock": true,
    "launch_revalidates_executable_before_handoff": true,
    "full_auto_active_blocking_hooks": false
  },
  "runtime_compatibility": {
    "baseline_ref": "references/kimi-code-baseline.json",
    "command": "kimi",
    "npm_package": "@moonshot-ai/kimi-code",
    "tested_release": "0.29.2",
    "official_install_channel": "official-binary",
    "npm_alternative_recorded": true,
    "windows_supported": false,
    "macos_supported": true,
    "ubuntu_linux_glibc_supported": true
  },
  "software_lifecycle": {
    "stamp_file": "NDDEV-KIMICODE-SOFTWARE.json",
    "stamp_schema": 2,
    "legacy_stamp_schema": 1,
    "status_command": "python3 cli-tools/nddev_kimicode.py software-status --target /absolute/target --json",
    "install_command": "python3 cli-tools/nddev_kimicode.py install-cli --target /absolute/target --json",
    "update_command": "python3 cli-tools/nddev_kimicode.py update-cli --target /absolute/target --json",
    "migrate_command": "python3 cli-tools/nddev_kimicode.py migrate-cli --target /absolute/target --json",
    "presence_signal": "software-status JSON exposes present=true and presence entries for NDDEV-KIMICODE-SOFTWARE.json, .nddev-kimicode-software, .nddev-kimicode-software/current, or bin/kimi",
    "install_precondition": "install-cli refuses existing target-owned software presence unless current",
    "update_precondition": "update-cli repairs non-legacy official-binary target-owned software presence and refuses absent or legacy software state",
    "migrate_precondition": "migrate-cli is the only transition from legacy Bun schema to official-binary schema",
    "channel": "official-binary",
    "manifest_url": "https://code.kimi.com/kimi-code/binaries/0.29.2/manifest.json",
    "manifest_sha256": "6057703f6430964741198c81617737bcec917082d1ce4aadd7a1b8c29787ae9b",
    "target_owned": true,
    "software_root": ".nddev-kimicode-software/current",
    "entrypoint": "bin/kimi",
    "entrypoint_kind": "official-binary",
    "status_executes_binary": false,
    "staged_version_probe": ["bin/kimi", "--version"],
    "private_modes": {
      "directories": "0700",
      "owner_executable_files": "0700",
      "other_files": "0600"
    },
    "credential_inheritance": false,
    "rollback_on_swap_failure": true
  },
  "runtime_launch": {
    "command": "kimi",
    "direct_command": ["/absolute/target/bin/kimi"],
    "manager_command": "python3 cli-tools/nddev_kimicode.py launch --target /absolute/target --",
    "required_version": "0.29.2",
    "environment_variable": "NDDEV_KIMICODE_TARGET",
    "forwards_arguments": true,
    "forwards_child_exit_code": true,
    "streams_child_stdio": true,
    "json_manager_errors_supported": true,
    "target_environment_scope": "target-owned /absolute/target/bin/kimi with isolated HOME, TMPDIR, and KIMI_CODE_HOME; credentials, sessions, logs, skills, agents, plugins, MCP, updates, and runtime data stay under the explicit target",
    "pre_login_supported": true,
    "lifecycle_lock_scope": "Held from launch preflight through child process completion and cleanup",
    "pre_handoff_executable_revalidation": "Immediately before subprocess handoff, /absolute/target/bin/kimi is reopened without following symlinks and checked for regular file type, current-user ownership, mode 0700, stable inode, and pinned official-binary digest"
  },
  "builder_toolkit": {
    "plugin_id": "nddev-builder",
    "plugin_manifest": "builder/nddev-builder/kimi.plugin.json",
    "marketplace_manifest": null,
    "external_marketplace_published": null,
    "runtime_plugin_install_state_written": false,
    "native_projection": {
      "AGENTS": "AGENTS.md under KIMI_CODE_HOME",
      "skills": "all files under builder/nddev-builder/skills/ projected to KIMI_CODE_HOME/skills/",
      "agents": "agents/nddev-builder.md plus extra_agent_dirs",
      "hooks": "hook source projected; active blocking hook only in safe profile",
      "MCP": "mcp.json managed without bundled servers or secrets",
      "plugins": "builder/nddev-builder/kimi.plugin.json remains source packaging only unless Kimi native plugin management installs it"
    }
  }
}
